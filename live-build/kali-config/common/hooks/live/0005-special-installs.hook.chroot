#!/bin/bash
# special installs from GitHub releases — fault tolerant, skips on failure

ok()   { echo "[OK]   $1"; }
skip() { echo "[SKIP] $1 -- $2"; }

try() {
    local desc="$1"; shift
    if ( set -e; "$@" ) 2>/dev/null; then
        ok "$desc"
    else
        skip "$desc" "failed, continuing"
    fi
}

gh_latest() {
    curl -s "https://api.github.com/repos/$1/releases/latest" \
        | grep '"tag_name"' | head -1 | cut -d'"' -f4
}

# ── Nuclei ────────────────────────────────────────────────────────────────────
echo "--- nuclei ---"
(
    VER=$(gh_latest projectdiscovery/nuclei)
    curl -sL "https://github.com/projectdiscovery/nuclei/releases/download/${VER}/nuclei_${VER#v}_linux_amd64.zip" \
        -o /tmp/nuclei.zip
    unzip -q /tmp/nuclei.zip -d /tmp/nuclei
    install -m 755 /tmp/nuclei/nuclei /usr/local/bin/nuclei
    rm -rf /tmp/nuclei /tmp/nuclei.zip
) && ok "nuclei" || skip "nuclei" "download/install failed"

# ── Chisel ────────────────────────────────────────────────────────────────────
echo "--- chisel ---"
(
    VER=$(gh_latest jpillora/chisel)
    curl -sL "https://github.com/jpillora/chisel/releases/download/${VER}/chisel_${VER#v}_linux_amd64.gz" \
        -o /tmp/chisel.gz
    gunzip /tmp/chisel.gz
    install -m 755 /tmp/chisel /usr/local/bin/chisel
    rm -f /tmp/chisel
) && ok "chisel" || skip "chisel" "download/install failed"

# ── Ligolo-ng ─────────────────────────────────────────────────────────────────
echo "--- ligolo-ng ---"
(
    VER=$(gh_latest nicocha30/ligolo-ng)
    curl -sL "https://github.com/nicocha30/ligolo-ng/releases/download/${VER}/ligolo-ng_agent_${VER#v}_linux_amd64.tar.gz" \
        -o /tmp/ligolo-agent.tar.gz
    curl -sL "https://github.com/nicocha30/ligolo-ng/releases/download/${VER}/ligolo-ng_proxy_${VER#v}_linux_amd64.tar.gz" \
        -o /tmp/ligolo-proxy.tar.gz
    tar -xzf /tmp/ligolo-agent.tar.gz -C /tmp
    tar -xzf /tmp/ligolo-proxy.tar.gz -C /tmp
    install -m 755 /tmp/agent /usr/local/bin/ligolo-agent
    install -m 755 /tmp/proxy /usr/local/bin/ligolo-proxy
    rm -f /tmp/ligolo-*.tar.gz /tmp/agent /tmp/proxy
) && ok "ligolo-ng" || skip "ligolo-ng" "download/install failed"

# ── pwncat-cs ─────────────────────────────────────────────────────────────────
echo "--- pwncat-cs ---"
pip3 install pwncat-cs --quiet 2>/dev/null \
    && ok "pwncat-cs" || skip "pwncat-cs" "pip install failed"

# ── evil-winrm ────────────────────────────────────────────────────────────────
echo "--- evil-winrm ---"
gem install evil-winrm --quiet 2>/dev/null \
    && ok "evil-winrm" || skip "evil-winrm" "gem install failed"

# ── Caido ─────────────────────────────────────────────────────────────────────
echo "--- caido ---"
(
    VER=$(gh_latest caido/caido)
    [ -z "$VER" ] && exit 1
    curl -sL "https://github.com/caido/caido/releases/download/${VER}/caido-cli-${VER#v}-linux-x86_64.tar.gz" \
        -o /tmp/caido.tar.gz
    tar -xzf /tmp/caido.tar.gz -C /tmp
    find /tmp -maxdepth 2 -name "caido*" -type f \
        -exec install -m 755 {} /usr/local/bin/caido \;
    rm -f /tmp/caido.tar.gz
) && ok "caido" || skip "caido" "download/install failed"

# ── Obsidian ──────────────────────────────────────────────────────────────────
echo "--- obsidian ---"
(
    VER=$(gh_latest obsidianmd/obsidian-releases)
    curl -sL "https://github.com/obsidianmd/obsidian-releases/releases/download/${VER}/obsidian_${VER#v}_amd64.deb" \
        -o /tmp/obsidian.deb
    dpkg -i /tmp/obsidian.deb
    apt-get install -f -y
    rm -f /tmp/obsidian.deb
) && ok "obsidian" || skip "obsidian" "download/install failed"

# ── Joplin ────────────────────────────────────────────────────────────────────
echo "--- joplin ---"
(
    VER=$(gh_latest laurent22/joplin)
    # try .deb first
    curl -sL "https://github.com/laurent22/joplin/releases/download/${VER}/Joplin-${VER#v}.deb" \
        -o /tmp/joplin.deb 2>/dev/null
    if [ ! -s /tmp/joplin.deb ]; then
        curl -sL "https://github.com/laurent22/joplin/releases/download/${VER}/joplin_${VER#v}_amd64.deb" \
            -o /tmp/joplin.deb 2>/dev/null
    fi
    if [ -s /tmp/joplin.deb ]; then
        dpkg -i /tmp/joplin.deb
        apt-get install -f -y
        rm -f /tmp/joplin.deb
    else
        # AppImage fallback
        mkdir -p /opt/joplin
        curl -sL "https://github.com/laurent22/joplin/releases/download/${VER}/Joplin-${VER#v}.AppImage" \
            -o /opt/joplin/Joplin.AppImage
        chmod +x /opt/joplin/Joplin.AppImage
        ln -sf /opt/joplin/Joplin.AppImage /usr/local/bin/joplin-desktop
        cat > /usr/share/applications/joplin.desktop << 'DEOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Joplin
Comment=Note taking and to-do application
Exec=/opt/joplin/Joplin.AppImage --no-sandbox %u
Icon=joplin
Terminal=false
Categories=Office;Notes;
MimeType=x-scheme-handler/joplin;
DEOF
    fi
) && ok "joplin" || skip "joplin" "download/install failed"

# ── desktop entries for tools without them ────────────────────────────────────
mkdir -p /usr/share/applications

command -v anonsurf &>/dev/null && cat > /usr/share/applications/anonsurf.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=AnonSurf
Comment=Anonymize traffic through Tor
Exec=pkexec anonsurf start
Icon=network-vpn
Terminal=false
Categories=Network;Security;
EOF

command -v codium &>/dev/null && cat > /usr/share/applications/codium.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=VSCodium
Comment=Open source code editor
Exec=codium %F
Icon=vscodium
Terminal=false
MimeType=text/plain;
Categories=TextEditor;Development;IDE;
EOF

echo ""
echo "=== special installs complete ==="
