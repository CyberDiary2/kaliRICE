#!/bin/bash
# install Parrot-origin tools not in Kali default: anonsurf, codium

set -e

# ── VSCodium ───────────────────────────────────────────────────────────────────
echo "installing VSCodium..."
wget -qO /usr/share/keyrings/vscodium.gpg \
    https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg

echo "deb [ signed-by=/usr/share/keyrings/vscodium.gpg ] \
https://paulcarroty.gitlab.io/vscodium-deb-rpm-repo/debs vscodium main" \
    > /etc/apt/sources.list.d/vscodium.list

apt-get update -q
apt-get install -y codium

# clean up repo after install so it doesn't conflict in the installed system
rm -f /etc/apt/sources.list.d/vscodium.list
apt-get update -q

# ── AnonSurf ──────────────────────────────────────────────────────────────────
echo "installing AnonSurf..."

# dependencies
apt-get install -y tor iptables macchanger resolvconf python3 python3-pip

# clone and install from Parrot source
git clone --depth=1 https://github.com/ParrotSec/anonsurf /tmp/anonsurf

cd /tmp/anonsurf

# install via make if Makefile exists, otherwise manual install
if [ -f Makefile ]; then
    make install 2>/dev/null || true
fi

# fallback: install any .deb in the repo
find /tmp/anonsurf -name "*.deb" -exec dpkg -i {} \; 2>/dev/null || true
apt-get install -f -y 2>/dev/null || true

# copy binaries manually if make install missed them
[ -f /tmp/anonsurf/usr/bin/anonsurf ] && \
    install -m 755 /tmp/anonsurf/usr/bin/anonsurf /usr/bin/anonsurf
[ -d /tmp/anonsurf/usr/lib/anonsurf ] && \
    cp -r /tmp/anonsurf/usr/lib/anonsurf /usr/lib/

# copy desktop entry if present
find /tmp/anonsurf -name "*.desktop" -exec cp {} /usr/share/applications/ \; 2>/dev/null || true

# enable tor service so anonsurf can start it
systemctl enable tor 2>/dev/null || true

cd /
rm -rf /tmp/anonsurf
