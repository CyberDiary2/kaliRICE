#!/bin/bash
# configure calamares with darbs branding — fault tolerant

ok()   { echo "[OK]   $1"; }
skip() { echo "[SKIP] $1 -- $2"; }

try() {
    local desc="$1"; shift
    if ( set -e; "$@" ) 2>/dev/null; then
        ok "$desc"
    else
        skip "$desc" "failed, continuing"
    fi
}

BRAND_DIR="/etc/calamares/branding/darbs"
mkdir -p "$BRAND_DIR"

cat > "$BRAND_DIR/branding.desc" << 'EOF'
componentName: darbs

welcomeStyleCalamares: true
welcomeExpandingLogo: true

strings:
    productName:         darbs
    shortProductName:    darbs
    version:             rolling
    shortVersion:        rolling
    versionedName:       darbs rolling
    shortVersionedName:  darbs rolling
    bootloaderEntryName: darbs
    productUrl:          https://github.com/CyberDiary2/kaliRICE
    supportUrl:          https://github.com/CyberDiary2/kaliRICE
    releaseNotesUrl:     https://github.com/CyberDiary2/kaliRICE

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "languages.png"

slideshow: "show.qml"

style:
    sidebarBackground:    "#2d353b"
    sidebarText:          "#d3c6aa"
    sidebarTextSelect:    "#a7c080"
    sidebarTextHighlight: "#a7c080"
EOF
ok "calamares branding.desc written"

# copy default images as fallback
for img in logo.png languages.png show.qml; do
    src="/usr/share/calamares/branding/default/$img"
    [ -f "$src" ] && cp "$src" "$BRAND_DIR/" 2>/dev/null || true
done
ok "calamares branding images copied"

# point settings.conf to darbs branding
if [ -f /etc/calamares/settings.conf ]; then
    sed -i 's/branding:.*/branding: darbs/' /etc/calamares/settings.conf \
        2>/dev/null && ok "calamares settings.conf patched" \
        || skip "calamares settings.conf patch" "sed failed"
else
    skip "calamares settings.conf" "file not found"
fi

# install desktop launcher
mkdir -p /home/darbs/Desktop
cat > /home/darbs/Desktop/install.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Install darbs
Comment=Install this system to disk
Exec=pkexec calamares
Icon=calamares
Terminal=false
Categories=System;
EOF
chmod +x /home/darbs/Desktop/install.desktop 2>/dev/null || true
chown darbs:darbs /home/darbs/Desktop/install.desktop 2>/dev/null || true
ok "install desktop launcher created"

echo ""
echo "=== calamares setup complete ==="
