#!/bin/bash
# install Parrot-origin tools: anonsurf, codium — fault tolerant

ok()   { echo "[OK]   $1"; }
skip() { echo "[SKIP] $1 -- $2"; }

try() {
    local desc="$1"; shift
    if ( set -e; "$@" ) 2>/dev/null; then
        ok "$desc"
    else
        skip "$desc" "failed, continuing"
    fi
}

# ── VSCodium ───────────────────────────────────────────────────────────────────
echo "--- installing VSCodium ---"
(
    wget -qO /usr/share/keyrings/vscodium.gpg \
        https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg && \
    echo "deb [ signed-by=/usr/share/keyrings/vscodium.gpg ] \
https://paulcarroty.gitlab.io/vscodium-deb-rpm-repo/debs vscodium main" \
        > /etc/apt/sources.list.d/vscodium.list && \
    apt-get update -q && \
    apt-get install -y codium && \
    rm -f /etc/apt/sources.list.d/vscodium.list && \
    apt-get update -q
) 2>/dev/null && ok "VSCodium installed" || skip "VSCodium" "install failed"

# ── AnonSurf ──────────────────────────────────────────────────────────────────
echo "--- installing AnonSurf ---"
apt-get install -y tor iptables macchanger resolvconf python3 2>/dev/null || true

(
    git clone --depth=1 https://github.com/ParrotSec/anonsurf /tmp/anonsurf && \
    cd /tmp/anonsurf && \
    if [ -f Makefile ]; then make install; fi
) 2>/dev/null && ok "AnonSurf installed via Makefile" || {
    # fallback: manual binary copy
    if [ -f /tmp/anonsurf/usr/bin/anonsurf ]; then
        install -m 755 /tmp/anonsurf/usr/bin/anonsurf /usr/bin/anonsurf 2>/dev/null || true
        [ -d /tmp/anonsurf/usr/lib/anonsurf ] && \
            cp -r /tmp/anonsurf/usr/lib/anonsurf /usr/lib/ 2>/dev/null || true
        ok "AnonSurf installed via manual copy"
    else
        skip "AnonSurf" "install failed"
    fi
}

# install any bundled .deb
find /tmp/anonsurf -name "*.deb" -exec dpkg -i {} \; 2>/dev/null || true
apt-get install -f -y 2>/dev/null || true

# copy desktop entries
find /tmp/anonsurf -name "*.desktop" \
    -exec cp {} /usr/share/applications/ \; 2>/dev/null || true

systemctl enable tor 2>/dev/null || true

rm -rf /tmp/anonsurf

echo ""
echo "=== extra tools complete ==="
