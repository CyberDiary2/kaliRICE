#!/bin/bash
# remove ALL Kali branding — fault tolerant, never exits on failure

ok()   { echo "[OK]   $1"; }
skip() { echo "[SKIP] $1 -- $2"; }

try() {
    local desc="$1"; shift
    if ( set -e; "$@" ) 2>/dev/null; then
        ok "$desc"
    else
        skip "$desc" "failed, continuing"
    fi
}

# ── wallpaper packages ─────────────────────────────────────────────────────────
try "remove kali wallpaper packages" \
    apt-get remove -y --purge \
        kali-wallpapers-legacy kali-wallpapers-2019 kali-wallpapers-2020 \
        kali-wallpapers-2021   kali-wallpapers-2022 kali-wallpapers-2023 \
        kali-wallpapers-2024

apt-get autoremove -y 2>/dev/null || true

# ── logo / dragon assets ───────────────────────────────────────────────────────
for f in \
    /usr/share/kali-themes/kali-logo*.png \
    /usr/share/kali-themes/kali-dragon*.svg \
    /usr/share/kali-themes/kali-dragon*.png \
    /usr/share/pixmaps/kali-logo*.png \
    /usr/share/pixmaps/kali-dragon*.png \
    /boot/grub/kali-grub.png \
    /boot/grub/kali_background.png; do
    rm -f "$f" 2>/dev/null || true
done
ok "removed kali logo/dragon assets"

# ── lightdm overrides ─────────────────────────────────────────────────────────
rm -f /etc/lightdm/lightdm-gtk-greeter.conf.d/kali.conf 2>/dev/null || true
ok "removed kali lightdm override"

# ── hostname ──────────────────────────────────────────────────────────────────
echo "darbs" > /etc/hostname
sed -i "s/kali/darbs/g" /etc/hosts 2>/dev/null || true
ok "set hostname to darbs"

# ── /etc/os-release ───────────────────────────────────────────────────────────
if [ -f /etc/os-release ]; then
    sed -i 's/^NAME=.*/NAME="darbs"/'                                              /etc/os-release
    sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="darbs rolling"/'                        /etc/os-release
    sed -i 's/^HOME_URL=.*/HOME_URL="https:\/\/github.com\/CyberDiary2\/kaliRICE"/' /etc/os-release
    sed -i 's/^SUPPORT_URL=.*/SUPPORT_URL="https:\/\/github.com\/CyberDiary2\/kaliRICE"/' /etc/os-release
    sed -i '/^LOGO=/d' /etc/os-release
    cp /etc/os-release /usr/lib/os-release 2>/dev/null || true
    ok "patched os-release"
else
    skip "os-release patch" "file not found"
fi

# ── GRUB ──────────────────────────────────────────────────────────────────────
rm -rf /usr/share/grub/themes/kali 2>/dev/null || true
rm -rf /boot/grub/themes/kali      2>/dev/null || true

cat > /etc/default/grub << 'EOF'
GRUB_DEFAULT=0
GRUB_TIMEOUT=3
GRUB_DISTRIBUTOR=darbs
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_TERMINAL_OUTPUT=console
EOF
ok "patched grub config"

# ── Plymouth + LUKS screen ────────────────────────────────────────────────────
mkdir -p /usr/share/plymouth/themes/darbs

cat > /usr/share/plymouth/themes/darbs/darbs.plymouth << 'EOF'
[Plymouth Theme]
Name=darbs
Description=Minimal dark Everforest boot theme
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/darbs
ScriptFile=/usr/share/plymouth/themes/darbs/darbs.script
EOF

cat > /usr/share/plymouth/themes/darbs/darbs.script << 'EOF'
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth()  / 2 - logo_image.GetWidth()  / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 60);

bar_bg = Rectangle(0, Window.GetHeight() - 10, Window.GetWidth(), 8);
bar_bg.SetFillColor(0.1, 0.1, 0.1, 1);

bar = Rectangle(0, Window.GetHeight() - 10, 1, 8);
bar.SetFillColor(0.2, 1.0, 0.2, 1);

fun progress_callback(duration, progress) {
    bar.SetWidth(Window.GetWidth() * progress);
}
Plymouth.SetBootProgressFunction(progress_callback);

fun password_callback(prompt, bullets) {
    message_sprite = Sprite();
    message_sprite.SetPosition(Window.GetWidth() / 2 - 200, Window.GetHeight() / 2 + 40, 10000);
    message_image = Image.Text(prompt, 0.2, 1.0, 0.2, 1);
    message_sprite.SetImage(message_image);
}
Plymouth.SetDisplayPasswordFunction(password_callback);
EOF

# install unifont for the VGA-style DARBS logo
apt-get install -y fonts-unifont 2>/dev/null || true

# generate pixelated DARBS logo: render small then upscale for chunky pixel look
convert -size 150x50 xc:"#000000" \
    -font /usr/share/fonts/opentype/unifont/unifont.otf \
    -pointsize 24 \
    -fill "#33FF33" \
    -gravity Center \
    -annotate 0 "DARBS" \
    -filter point -resize 600x200 \
    /usr/share/plymouth/themes/darbs/logo.png 2>/dev/null || \
convert -size 600x200 xc:"#000000" \
    -fill "#33FF33" \
    -gravity Center \
    -annotate 0 "DARBS" \
    /usr/share/plymouth/themes/darbs/logo.png 2>/dev/null || true

try "set plymouth theme darbs" \
    update-alternatives --install \
        /usr/share/plymouth/themes/default.plymouth \
        default.plymouth \
        /usr/share/plymouth/themes/darbs/darbs.plymouth 200

( plymouth-set-default-theme darbs   2>/dev/null || \
  plymouth-set-default-theme spinner 2>/dev/null || \
  true ) && ok "plymouth theme set" || skip "plymouth theme" "could not set"

try "update-initramfs" update-initramfs -u

echo ""
echo "=== branding removal complete ==="
