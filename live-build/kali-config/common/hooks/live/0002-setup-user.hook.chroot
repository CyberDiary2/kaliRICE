#!/bin/bash
# create darbs user — fault tolerant

ok()   { echo "[OK]   $1"; }
skip() { echo "[SKIP] $1 -- $2"; }

try() {
    local desc="$1"; shift
    if ( set -e; "$@" ) 2>/dev/null; then
        ok "$desc"
    else
        skip "$desc" "failed, continuing"
    fi
}

USERNAME="darbs"

# ── user setup ────────────────────────────────────────────────────────────────
if id kali &>/dev/null && [ "$USERNAME" != "kali" ]; then
    usermod -l "$USERNAME"             kali       2>/dev/null || true
    usermod -d /home/"$USERNAME" -m    "$USERNAME" 2>/dev/null || true
    groupmod -n "$USERNAME"            kali       2>/dev/null || true
    sed -i "s/kali/$USERNAME/g" /etc/sudoers.d/kali 2>/dev/null || true
    ok "renamed kali user to $USERNAME"
fi

if ! id "$USERNAME" &>/dev/null; then
    useradd -m -s /bin/bash -G sudo,adm,cdrom,dip,plugdev,netdev "$USERNAME" \
        2>/dev/null || true
    ok "created user $USERNAME"
fi

echo "$USERNAME ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/"$USERNAME"
chmod 440 /etc/sudoers.d/"$USERNAME"
ok "configured passwordless sudo"

echo "$USERNAME:darbs" | chpasswd 2>/dev/null || true
ok "set password"

chown -R "$USERNAME":"$USERNAME" /home/"$USERNAME" 2>/dev/null || true

su - "$USERNAME" -c "mkdir -p \
    /home/$USERNAME/.config/autostart \
    /home/$USERNAME/Desktop \
    /home/$USERNAME/Downloads \
    /home/$USERNAME/Pictures/wallpapers" 2>/dev/null || true

# ── greeter wallpaper ─────────────────────────────────────────────────────────
mkdir -p /usr/share/backgrounds/everforest
try "download greeter wallpaper" \
    curl -sL \
        "https://raw.githubusercontent.com/cyberdiary2/dotfiles/main/wallpapers/0001.jpg" \
        -o /usr/share/backgrounds/everforest/greeter.jpg
chmod 644 /usr/share/backgrounds/everforest/greeter.jpg 2>/dev/null || true

# ── Everforest GTK theme ───────────────────────────────────────────────────────
if [ ! -d /usr/share/themes/Everforest-Dark-BL ]; then
    try "clone Everforest GTK theme" \
        git clone --depth=1 \
            https://github.com/Fausto-Korpsvart/Everforest-GTK-Theme \
            /tmp/everforest-gtk
    if [ -d /tmp/everforest-gtk ]; then
        cp -r /tmp/everforest-gtk/themes/Everforest-Dark-BL /usr/share/themes/ 2>/dev/null || true
        rm -rf /tmp/everforest-gtk
        ok "Everforest GTK theme installed"
    fi
else
    ok "Everforest GTK theme already present"
fi

# ── Papirus folder colors ──────────────────────────────────────────────────────
if command -v papirus-folders &>/dev/null; then
    try "papirus green folders" papirus-folders -C green --theme Papirus-Dark
else
    skip "papirus-folders" "not installed"
fi

chown -R "$USERNAME":"$USERNAME" /home/"$USERNAME" 2>/dev/null || true

echo ""
echo "=== user setup complete ==="
